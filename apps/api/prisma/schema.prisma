generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFY   @map("email_verify")
  PASSWORD_RESET @map("password_reset")

  @@map("auth_token_type")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  // Always stored lowercased by the application.
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  memberships   Membership[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  // SHA-256 of the opaque token. The raw token is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

enum MembershipRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
  VIEWER @map("viewer")

  @@map("membership_role")
}

model Organization {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  slug             String   @unique
  stripeCustomerId String?  @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  clients     Client[]

  invoices                   Invoice[]
  invoiceLineItems           InvoiceLineItem[]
  invoiceCounter             InvoiceCounter?
  recurringTemplates         RecurringTemplate[]
  recurringTemplateLineItems RecurringTemplateLineItem[]

  @@map("organizations")
}

model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Client {
  id             String    @id @default(uuid(7)) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  name           String
  email          String?
  billingAddress String?   @map("billing_address")
  taxId          String?   @map("tax_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  recurringTemplates RecurringTemplate[]

  @@unique([id, orgId])
  @@index([orgId, createdAt])
  @@map("clients")
}

enum InvoiceStatus {
  DRAFT   @map("draft")
  SENT    @map("sent")
  PAID    @map("paid")
  OVERDUE @map("overdue")
  VOID    @map("void")

  @@map("invoice_status")
}

model Invoice {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orgId               String        @map("org_id") @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  number              String?
  status              InvoiceStatus @default(DRAFT)
  currency            String        @default("USD") @db.Char(3)
  issueDate           DateTime      @map("issue_date") @db.Date
  dueDate             DateTime      @map("due_date") @db.Date
  subtotalCents       BigInt        @default(0) @map("subtotal_cents")
  taxCents            BigInt        @default(0) @map("tax_cents")
  totalCents          BigInt        @default(0) @map("total_cents")
  sentAt              DateTime?     @map("sent_at") @db.Timestamptz(6)
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)
  voidedAt            DateTime?     @map("voided_at") @db.Timestamptz(6)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)
  recurringTemplateId String?       @map("recurring_template_id") @db.Uuid
  recurringRunOn      DateTime?     @map("recurring_run_on") @db.Date
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client            Client             @relation(fields: [clientId, orgId], references: [id, orgId], onDelete: NoAction)
  lineItems         InvoiceLineItem[]
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: NoAction)

  @@unique([orgId, number])
  @@unique([recurringTemplateId, recurringRunOn])
  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orgId          String  @map("org_id") @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  position       Int
  description    String
  quantity       Decimal @db.Decimal(12, 4)
  unitPriceCents BigInt  @map("unit_price_cents")
  taxRateBps     Int     @map("tax_rate_bps")
  lineTotalCents BigInt  @map("line_total_cents")
  lineTaxCents   BigInt  @map("line_tax_cents")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([orgId])
  @@map("invoice_line_items")
}

model InvoiceCounter {
  orgId      String @id @map("org_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invoice_counters")
}

enum RecurringFrequency {
  WEEKLY    @map("weekly")
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  YEARLY    @map("yearly")

  @@map("recurring_frequency")
}

model RecurringTemplate {
  id         String             @id @default(uuid(7)) @db.Uuid
  orgId      String             @map("org_id") @db.Uuid
  clientId   String             @map("client_id") @db.Uuid
  name       String
  currency   String             @default("USD") @db.Char(3)
  frequency  RecurringFrequency
  anchorDate DateTime           @map("anchor_date") @db.Date
  runCount   Int                @default(0) @map("run_count")
  nextRunOn  DateTime?          @map("next_run_on") @db.Date
  endDate    DateTime?          @map("end_date") @db.Date
  dueInDays  Int                @default(30) @map("due_in_days")
  autoSend   Boolean            @default(false) @map("auto_send")
  active     Boolean            @default(true)
  deletedAt  DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client                      @relation(fields: [clientId, orgId], references: [id, orgId], onDelete: NoAction)
  lineItems RecurringTemplateLineItem[]
  invoices  Invoice[]

  @@unique([id, orgId])
  @@index([orgId])
  @@index([nextRunOn], map: "recurring_templates_due_idx")
  @@map("recurring_templates")
}

model RecurringTemplateLineItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orgId          String  @map("org_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  position       Int
  description    String
  quantity       Decimal @db.Decimal(12, 4)
  unitPriceCents BigInt  @map("unit_price_cents")
  taxRateBps     Int     @map("tax_rate_bps")

  org      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template RecurringTemplate @relation(fields: [templateId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([orgId])
  @@map("recurring_template_line_items")
}
