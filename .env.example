# Copy to .env for local development. .env is gitignored and must never be committed.
# These values are throwaway local-only defaults, never reuse them anywhere real.

# Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_only
POSTGRES_DB=invoicing
POSTGRES_PORT=5433

# Database roles (ADR-0003): app_owner runs migrations, app_user is used by the API
APP_OWNER_PASSWORD=owner_local_only
APP_USER_PASSWORD=user_local_only

# Connection strings used by the API and by migrations
DATABASE_URL=postgresql://app_user:user_local_only@localhost:5433/invoicing
MIGRATION_DATABASE_URL=postgresql://app_owner:owner_local_only@localhost:5433/invoicing

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# API
PORT=4000

# Auth (generate your own: openssl rand -base64 48)
JWT_ACCESS_SECRET=change_me_local_only_at_least_32_characters_long

# Mail (Phase 7): Mailpit catches all outgoing mail locally. UI at http://localhost:8025
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Invoicing <no-reply@invoicing.local>"
